# Port the Express server listens on.
PORT=3000

# Local Supabase stack (started with `npm run db:start`).
# Run `npm run db:status` and copy the API URL and the service_role / secret key.
# docker-compose overrides SUPABASE_URL so the container can reach the host.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=paste-service-role-key-here
