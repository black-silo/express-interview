{
  "name": "express-interview",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Supabase starter for full stack interviews",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:migration:new": "supabase migration new"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "supabase": "^3.1.0"
  }
}
